
array_init = (size) => {
    out = []
    while (len(out) < size) {
        out = append(out, 0)
    }
    return out
}

// Map implementation
map = (items, func) => {
    if (type(items) == 'array') {
        index = 0
        out = append([], items)
        while (index < len(out)) {
            tmp = func(out[index])
            out[index] = tmp
            index = index + 1
        }
        return out
    } elif (type(items) == 'iterator') {
        next_fn = (source) => func(next(source))
        has_next_fn = (source) => has_next(source)
        peek_fn = (source) => func(peek(source))

        return custom_iterator(items, next_fn, has_next_fn, peek_fn)
    } else {
        return func(items)
    }
}

do = (items, func) => map(items, func)

flatten = (items) => {
    if (type(items) == 'array') {
        out = []
        index = 0
        while (index < len(items)) {
            out = append(out, items[index])
            index = index + 1
        }
        return out
    } elif (type(items) == 'iterator') {
        context = {}
        context['source'] = items
        context['current'] = none
        next_fn = (context) => {
            if (not is_none(context['current']) and has_next(context['current'])) {
                context['current'] = default_iterator(next(context['source']))
            }
            return next(context['current'])
        }
        has_next_fn = (context) => {
            if (is_none(context['current'])) {
                return has_next(context['source'])
            } else {
                if (has_next(context['current'])) {
                    return true
                } else {
                    return has_next(context['source'])
                }
            }
        }
        peek_fn = (context) => {
            if (not is_none(context['current']) and has_next(context['current'])) {
                context['current'] = default_iterator(next(context['source']))
            }
            return peek(context['current'])
        }

        return custom_iterator(context, next_fn, has_next_fn, peek_fn)
    } else {
        return items
    }
}

flatmap = (items, func) => flatten(map(items, func))

filter = (items, pred) => {
    if (type(items) == 'array') {
        index = 0
        out = []
        while (index < len(items)) {
            if (pred(items[index])) {
                out = append(out, items[index])
            }
            index = index + 1
        }
        return out
    } else {
        return items
    }
}

reduce = (items, func) => {
    if (type(items) == 'array') {
        acc = items[0]
        index = 1
        while (index < len(items)) {
            acc = func(acc, items[index])
            index = index + 1
        }
        return acc
    } else {
        return items
    }
}

group_by = (items, groupper) => {
    out = {}
    if (type(items) == 'array') {
        index = 0
        while (index < len(items)) {
            key = groupper(items[index])
            if (is_none(out[key])) {
                tmp = filter(items, (x) => groupper(x) == key)
                out[key] = tmp
            }
            index = index + 1
        }
        return out
    } else {
        return items
    }
}

// NOTE: `items` is assumed to be an array
swap = (items, left, right) => {
    tmp = items[left]
    items[left] = items[right]
    items[right] = tmp
}

// NOTE: `items` is assumed to be an array
partition = (items, compare) => {
    pivot = len(items) - 1
    left = 0
    while (left < pivot) {
        l = items[left]
        p = items[pivot]
        if (compare(l, p)) {
            left = left + 1
        } else {
            swap(items, left, pivot)
            if (left != pivot - 1) {
                swap(items, left, pivot - 1)
            }
            pivot = pivot - 1
        }
    }
    return pivot
}

// NOTE: `items` is assumed to be an array
sort_implementation = (items, compare) => {
    count = len(items)
    if (count < 2) {
        return none
    }

    partition_point = partition(items, compare)
    left = take(items, partition_point)
    sort_implementation(left, compare)
    right = drop(items, partition_point)
    sort_implementation(right, compare)
}


sort = (items, compare) => {
    if (type(items) != 'array') {
        return none
    }
    sort_implementation(items, compare)
    return items
}

first = (items, pred, default) => {
    if (type(items) == 'array') {
        index = 0
        while (index < len(items)) {
            if (pred(items[index])) {
                return items[index]
            }
            index = index + 1
        }
        return default
    } else {
        return default
    }
}

last = (items, pred, default) => {
    if (type(items) == 'array') {
        index = len(items) - 1
        while (index >= 0) {
            if (pred(items[index])) {
                return items[index]
            }
            index = index - 1
        }
        return default
    } else {
        return default
    }
}

check_impl = (items, pred, init, func) => {
    if (type(items) == 'array') {
        index = 0
        out = init
        while (index < len(items)) {
            out = func(out, pred(items[index]))
            index = index + 1
        }
        return out
    } else {
        return init
    }
}

count = (items, pred) => check_impl(items, pred, 0, (acc, value) => number(value) + acc)
check_none = (items, pred) => check_impl(items, pred, true, (acc, value) => not value and acc)
check_any = (items, pred) => check_impl(items, pred, false, (acc, value) => value or acc)
check_all = (items, pred) => check_impl(items, pred, true, (acc, value) => value and acc)

